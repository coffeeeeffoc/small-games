{
  "name": "@coffeeeeffoc/shell-minigame",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "node scripts/build.mjs --all --preview",
    "build:game": "node scripts/build.mjs",
    "build:all": "node scripts/build.mjs --all --preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "smoke": "node ../../scripts/native-game-smoke.mjs --standalone"
  },
  "dependencies": {
    "@coffeeeeffoc/platform-wechat": "workspace:*",
    "@coffeeeeffoc/platform-douyin": "workspace:*",
    "@coffeeeeffoc/platform-bilibili": "workspace:*",
    "@coffeeeeffoc/native-game-shell": "workspace:*",
    "@coffeeeeffoc/canvas-game-adapter": "workspace:*",
    "@coffeeeeffoc/game-contract": "workspace:*",
    "@coffeeeeffoc/game-cricket": "workspace:*",
    "@coffeeeeffoc/game-cultivation": "workspace:*",
    "@coffeeeeffoc/game-arena": "workspace:*",
    "@coffeeeeffoc/game-building-power": "workspace:*",
    "@coffeeeeffoc/game-office": "workspace:*"
  },
  "devDependencies": {
    "@coffeeeeffoc/config-typescript": "workspace:*",
    "@coffeeeeffoc/config-eslint": "workspace:*",
    "@types/node": "24.3.1",
    "typescript": "7.0.2",
    "eslint": "9.35.0",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  },
  "coffeeeeffoc": {
    "role": "shell"
  }
}
