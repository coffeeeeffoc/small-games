    "test:sharing": "node scripts/game-sharing-smoke.mjs",
    "test": "vitest run",
    "test:integration": "vitest run tests/shell.integration.test.tsx tests/standalone.integration.test.tsx tests/routes.integration.test.tsx",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings 0",
    "smoke": "node scripts/smoke.mjs",
    "smoke:remote": "node scripts/remote-smoke.mjs",
    "test:pages:artifacts": "node scripts/pages-artifacts.mjs"
