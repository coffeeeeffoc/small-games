{
  "name": "@coffeeeeffoc/shell-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "node scripts/prepare-standalone-games.mjs && vite --host 0.0.0.0",
    "build": "node scripts/prepare-standalone-games.mjs && tsc -b && vite build",
    "build:pages": "node scripts/prepare-standalone-games.mjs && tsc -b && vite build --mode pages",
    "test:pages": "node scripts/pages-smoke.mjs",
    "test:fullscreen-touch": "node scripts/fullscreen-touch-check.mjs",
    "test": "vitest run",
    "test:integration": "vitest run tests/shell.integration.test.tsx tests/standalone.integration.test.tsx tests/routes.integration.test.tsx",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings 0",
    "smoke": "node scripts/smoke.mjs",
    "smoke:remote": "node scripts/remote-smoke.mjs"
  },
  "dependencies": {
    "@coffeeeeffoc/carding-car": "workspace:*",
    "@small-games/merge-front": "workspace:*",
    "@small-games/night-merge": "workspace:*",
    "tidebreak": "workspace:*",
    "@coffeeeeffoc/tower-defense-game": "workspace:*",
    "@coffeeeeffoc/xiangqi-five": "workspace:*",
    "@coffeeeeffoc/office-slacking": "workspace:*",
    "@coffeeeeffoc/release-contract": "workspace:*",
    "@coffeeeeffoc/ad-config": "workspace:*",
    "@coffeeeeffoc/ad-runtime": "workspace:*",
    "@coffeeeeffoc/content-schema": "workspace:*",
    "@coffeeeeffoc/game-arena": "workspace:*",
    "@coffeeeeffoc/game-building-power": "workspace:*",
    "@coffeeeeffoc/game-contract": "workspace:*",
    "@coffeeeeffoc/game-cultivation": "workspace:*",
    "@coffeeeeffoc/game-host": "workspace:*",
    "@coffeeeeffoc/game-loader": "workspace:*",
    "@coffeeeeffoc/game-office": "workspace:*",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "@coffeeeeffoc/game-cricket": "workspace:*",
    "cops-robbers": "workspace:*",
    "cops-robbers-realtime": "workspace:*",
    "between-calls": "workspace:*",
    "letters-words": "workspace:*",
    "ciyu-word-tiles": "workspace:*",
    "multi-battle": "workspace:*",
    "before-the-rain-stops": "workspace:*",
    "quye-travel": "workspace:*",
    "@coffeeeeffoc/travel2": "workspace:*",
    "@coffeeeeffoc/travel-bund": "workspace:*",
    "@coffeeeeffoc/travel-bund-25d": "workspace:*",
    "tangerine-express": "workspace:*",
    "here-and-then": "workspace:*",
    "null-range-mobile-cn": "workspace:*"
  },
  "devDependencies": {
    "@coffeeeeffoc/config-eslint": "workspace:*",
    "@coffeeeeffoc/config-typescript": "workspace:*",
    "@coffeeeeffoc/vite-smoke-test": "workspace:*",
    "@playwright/test": "1.55.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "9.35.0",
    "jsdom": "26.1.0",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  },
  "coffeeeeffoc": {
    "role": "shell"
  }
}
