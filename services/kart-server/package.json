{
  "name": "@coffeeeeffoc/kart-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "dev": "node --watch src/main.ts",
    "start": "node src/main.ts",
    "share": "node src/share.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts"
  },
  "dependencies": {
    "@coffeeeeffoc/carding-car": "workspace:*",
    "fastify": "5.12.3",
    "ws": "8.21.3",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@types/node": "24.3.1",
    "@types/ws": "8.18.1",
    "typescript": "7.0.2"
  },
  "coffeeeeffoc": {
    "role": "service"
  }
}
