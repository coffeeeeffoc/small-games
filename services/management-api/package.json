{
  "name": "@coffeeeeffoc/management-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "tsx src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "pnpm build && vitest run",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@coffeeeeffoc/game-cultivation": "workspace:*",
    "@fastify/cookie": "11.1.2",
    "@fastify/rate-limit": "11.2.0",
    "@node-rs/argon2": "2.2.0",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.3",
    "@coffeeeeffoc/service-kit": "workspace:*",
    "zod": "4.1.5",
    "@aws-sdk/client-s3": "3.1127.0"
  },
  "devDependencies": {
    "@coffeeeeffoc/config-eslint": "workspace:*",
    "@coffeeeeffoc/config-typescript": "workspace:*",
    "@types/node": "24.3.1",
    "eslint": "9.35.0",
    "typescript": "7.0.2",
    "vitest": "5.0.0",
    "tsx": "4.23.13"
  },
  "coffeeeeffoc": {
    "role": "service"
  }
}
