# Inject through your shell or service Secret Store; scripts do not implicitly load this file.
COMPETITION_ENABLED=true
COMPETITION_PORT=43002
KART_SERVER_PORT=43003
COMPETITION_GATEWAY_PORT=43010
RUNTIME_DATABASE_URL=postgres://runtime_app:local-runtime-only@127.0.0.1:15432/small_games
COMPETITION_ORIGINS=http://127.0.0.1:43010,http://localhost:43010
# Server-only JSON array of platform/appId/secret; do not add real secrets to Git.
COMPETITION_PLATFORM_CONFIG=[]
# Dev runner creates a random internal key in .scratch; production injects the same secret into both services.
