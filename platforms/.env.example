# Public client parameters only. Replace GAME with the existing builder's game key
# (uppercase, '-' -> '_'). This file is a template; load explicitly with node --env-file.
# Existing native Canvas hosts. Each game still needs its own reviewed native entry.
MINIGAME_GAME_WECHAT_APP_ID=
MINIGAME_GAME_WECHAT_AD_UNIT_ID=
MINIGAME_GAME_DOUYIN_APP_ID=
MINIGAME_GAME_DOUYIN_AD_UNIT_ID=
MINIGAME_GAME_BILIBILI_APP_ID=
MINIGAME_GAME_BILIBILI_AD_UNIT_ID=
MINIGAME_GAME_KUAISHOU_APP_ID=
MINIGAME_GAME_ALIPAY_APP_ID=
MINIGAME_GAME_TAPTAP_APP_ID=
# Ads for Kuaishou/Alipay/TapTap are unsupported, intentionally no usable ad setting.
# Server public URL only, no credentials/tokens. Existing nine-game builder consumes it.
MINIGAME_COMPETITION_API_URL=
# Reserved names only: NO native host/login/advertising implementation for these channels.
# The configuration script rejects them until a real adapter is implemented and validated.
MINIGAME_GAME_QQ_APP_ID=
MINIGAME_GAME_BAIDU_APP_ID=
MINIGAME_GAME_OPPO_APP_ID=
MINIGAME_GAME_VIVO_APP_ID=
MINIGAME_GAME_HUAWEI_APP_ID=
MINIGAME_GAME_XIAOMI_APP_ID=
# COMPETITION_PLATFORM_CONFIG and AppSecret/private keys belong ONLY in server env files.
