    "typecheck": "node scripts/typecheck.mjs",
    "lint": "eslint . --max-warnings 0",
    "smoke": "node scripts/cocos-smoke.mjs",
    "test:rules": "vitest run --maxWorkers=1 src/duel.test.ts src/duel-server.test.ts src/campaign.test.ts src/duel-session.test.ts src/duel-trajectory.test.ts src/definition.test.ts src/cocos-session.test.ts && node --test scripts/artifact.test.mjs",
    "test:native": "node scripts/native-check.mjs",
    "test:input": "node scripts/cocos-smoke.mjs",
    "smoke:campaign": "node scripts/cocos-campaign.mjs",
    "preview": "node scripts/serve.mjs",
    "prepare": "node scripts/prepare.mjs",
    "build:legacy": "tsc -b && vite build --outDir legacy-dist"
  },
  "dependencies": {
    "@coffeeeeffoc/canvas-game-adapter": "workspace:*",
    "@coffeeeeffoc/content-schema": "workspace:*",
