{
  "name": "@coffeeeeffoc/game-castle-cannon",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/definition.ts",
    "./canvas": "./src/index.ts",
    "./manifest": "./src/manifest.json"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build && vite build --config vite.server.config.ts",
    "serve:duel": "node server-dist/duel-service.js",
    "test": "vitest run",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings 0",
    "smoke": "node scripts/browser-check.mjs",
    "test:rules": "vitest run src/duel.test.ts src/duel-server.test.ts src/progress.test.ts src/definition.test.ts",
    "test:native": "node scripts/native-check.mjs",
    "test:input": "node scripts/input-check.mjs"
  },
  "dependencies": {
    "@coffeeeeffoc/canvas-game-adapter": "workspace:*",
    "@coffeeeeffoc/content-schema": "workspace:*",
    "@coffeeeeffoc/game-contract": "workspace:*",
    "@coffeeeeffoc/game-host": "workspace:*",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@coffeeeeffoc/config-eslint": "workspace:*",
    "@coffeeeeffoc/config-typescript": "workspace:*",
    "@playwright/test": "1.55.1",
    "@types/three": "0.180.0",
    "eslint": "9.35.0",
    "jsdom": "26.1.0",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  },
  "coffeeeeffoc": {
    "role": "game"
  }
}
