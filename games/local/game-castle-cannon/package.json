    "@types/three": "0.180.0",
    "eslint": "9.35.0",
    "jsdom": "26.1.0",
    "typescript": "7.0.2",
    "vite": "8.2.4",
    "vitest": "5.0.0"
  },
  "coffeeeeffoc": {
    "role": "game"
  },
