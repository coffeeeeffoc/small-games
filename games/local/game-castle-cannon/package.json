{
  "name": "@coffeeeeffoc/game-castle-cannon",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/definition.ts",
    "./canvas": "./src/index.ts",
    "./manifest": "./src/manifest.json"
  },
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs web-mobile",
