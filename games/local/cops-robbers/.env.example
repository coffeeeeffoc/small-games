# Copy to .env in this game directory; deploy:taptap loads it automatically.
# Existing process environment variables take precedence. No upload credentials here.
# TapTap H5 is distinct from native MINIGAME_*_TAPTAP settings.
# The app must support H5 packages; the uploader checks this before uploading.
TAPTAP_DEVELOPER_ID=
TAPTAP_COPS_ROBBERS_APP_ID=
# Leave empty while ads are under review; obtain the portrait slot from check_ads_status.
TAPTAP_COPS_ROBBERS_AD_UNIT_ID=
# Optional fixed browser path; empty means automatically try cached Chromium, Chrome and Edge.
# PLAYWRIGHT_EXECUTABLE_PATH='C:\Program Files\Google\Chrome\Application\chrome.exe'
PLAYWRIGHT_EXECUTABLE_PATH=
# Upload credentials stay in the official CLI local login: taptap-cli auth login.
