{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "experimentalDecorators": true,
    "allowImportingTsExtensions": true,
    "types": [],
    "lib": ["ES2023", "DOM"],
    "allowJs": true,
    "checkJs": false
  },
  "include": ["assets/scripts/**/*.ts", "reports/engine.d.ts", "assets/scripts/**/*.js"]
}
