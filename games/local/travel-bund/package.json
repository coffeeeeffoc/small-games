{
  "name": "@coffeeeeffoc/travel-bund",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 4186",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4186",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "test:browser": "node tests/browser.mjs",
    "test:controls": "node tests/controls.mjs",
    "test:mobile": "node tests/mobile-browser.mjs",
    "test:routes": "node tests/routes-browser.mjs",
    "test:photo-hunts": "node tests/photo-hunts-browser.mjs",
    "test:photo-hunts:scene": "node tests/photo-hunts-scene.mjs",
    "test:performance": "node tests/performance.mjs",
    "test:life": "node tests/life-browser.mjs",
    "test:settings": "node tests/settings-browser.mjs",
    "test:sky": "node tests/clouds-browser.mjs && node tests/clouds-scene-browser.mjs",
    "test:preview": "node tests/preview-browser.mjs"
  },
  "dependencies": {
    "@react-three/drei": "10.7.8",
    "@react-three/fiber": "9.7.0",
    "@react-three/rapier": "2.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.180.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  },
  "coffeeeeffoc": {
    "role": "game"
  }
}
