{
  "name": "cops-robbers-realtime",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "start": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:levels": "node scripts/verify-levels.mjs",
    "build": "node scripts/build.mjs",
    "test:browser": "node tests/publishing.browser.mjs && node tests/safe-area.browser.mjs",
    "test:mobile-pages": "node tests/publishing.browser.mjs",
    "package:taptap": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-taptap.ps1",
    "test:runner-browser": "node scripts/runner-playtest.mjs",
    "test:performance": "node tests/performance.browser.mjs",
    "assets:optimize": "python scripts/optimize-images.py",
    "test:assets": "python scripts/optimize-images.py --check"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "playwright": "^1.63.0"
  }
}
