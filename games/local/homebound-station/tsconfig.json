{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "allowImportingTsExtensions": true,
    "types": []
  },
  "include": [
    "assets/scripts/**/*.ts",
    "reports/engine.d.ts"
  ]
}
