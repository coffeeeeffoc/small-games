# Run from the game directory: node --env-file=server/.env server/index.mjs
NODE_ENV=production
HOST=0.0.0.0
PORT=4185
# HISTORY_PORT is a fallback only when PORT is unset.
# HISTORY_PORT=4185
HISTORY_DB_PATH=./server/data/history.sqlite
HISTORY_QUESTION_DIR=./server/private/questions
HISTORY_ASSET_DIR=./public
# Optional absolute path to an already built frontend dist directory.
# Leave unset for API-only service behind a reverse proxy.
# HISTORY_STATIC_DIR=/srv/here-and-then/dist

# Required in production. Generate at least 32 random bytes; never ship to browsers.
HISTORY_IDENTITY_SECRET=

# Comma-separated browser origins, with scheme and optional port; no URL path.
# Replace this example with the actual HTTPS game origin.
HISTORY_ALLOWED_ORIGINS=https://history.example.com
HISTORY_COMPETITION_TIMEZONE=Asia/Shanghai
# Set to 1 only behind a trusted proxy that overwrites X-Real-IP.
# The API port must then be unreachable directly by untrusted clients.
HISTORY_TRUST_PROXY=0

# Optional host port for compose; the container always listens on 4185.
HISTORY_PUBLIC_PORT=4185
