    "test:release": "node tests/release.mjs"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.180.0",
    "@types/node": "24.10.4",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "@playwright/test": "1.55.1"
  },
  "coffeeeeffoc": {
    "role": "game"
  }
}
