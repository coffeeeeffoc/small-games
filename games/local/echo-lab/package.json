{
  "name": "@coffeeeeffoc/echo-lab",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "A small, local-first acoustic sandbox",
  "engines": {
    "node": ">=24.21.0"
  },
  "scripts": {
    "dev": "node server.js",
    "start": "node server.js",
    "check": "node scripts/check.mjs",
    "test": "node --test tests/*.test.js",
    "test:browser": "node tests/audio.browser.js && node tests/ui.browser.js && node tests/platforms.browser.js",
    "build": "node build.mjs",
    "dev:web": "node server.js web",
    "dev:h5": "node server.js h5",
    "build:web": "node build.mjs web",
    "build:h5": "node build.mjs h5",
    "build:wechat": "node build.mjs wechat",
    "build:all": "node build.mjs web && node build.mjs h5 && node build.mjs wechat"
  },
  "coffeeeeffoc": {
    "role": "game"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
