{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "noEmit": true,
    "experimentalDecorators": true,
    "allowImportingTsExtensions": true,
    "types": [],
    "lib": ["ES2023", "DOM"]
  },
  "include": ["assets/scripts/**/*.ts", "reports/engine.d.ts"]
}
