CCEffect %{
  techniques:
  - passes:
    - vert: alpine-vs:vert
      frag: alpine-fs:frag
      properties:
        mainTexture: { value: grey }
        slateTexture: { value: grey }
}%
CCProgram alpine-vs %{
  precision highp float;
  #include <legacy/input>
  #include <builtin/uniforms/cc-global>
  #include <legacy/local-batch>
  out vec3 position;
  out vec3 normal;
  vec4 vert () {
    vec4 p; CCVertInput(p);
    mat4 world; CCGetWorldMatrix(world);
    position = (world * p).xyz;
    normal = normalize((world * vec4(a_normal, 0.0)).xyz);
    return cc_matProj * cc_matView * vec4(position, 1.0);
  }
}%
CCProgram alpine-fs %{
  precision highp float;
  #include <legacy/output-standard>
  #include <builtin/uniforms/cc-global>
  in vec3 position;
  in vec3 normal;
  uniform sampler2D mainTexture;
  uniform sampler2D slateTexture;
  vec4 frag () {
    vec3 n = normalize(normal);
    vec3 weights = pow(abs(n), vec3(4.0)); weights /= weights.x + weights.y + weights.z;
    float nearDetail = 1.0-smoothstep(350.0,2400.0,distance(cc_cameraPos.xyz,position));
    // The photo supplies faint metre-scale grain, never repeated mountain-sized markings.
    vec3 detail = texture(slateTexture, position.zy / 32.0).rgb * weights.x
      + texture(slateTexture, position.xz / 32.0).rgb * weights.y
      + texture(slateTexture, position.xy / 32.0).rgb * weights.z;
    float grain = mix(0.5,texture(mainTexture,position.xz/9.0).r,nearDetail);
    float broad = clamp((texture(mainTexture,(position.xz + vec2(position.z*0.17,position.x*0.11))/2300.0).r-0.25)*2.0,0.0,1.0);
    float coverage = clamp((texture(mainTexture,position.zx/4100.0 + broad*0.3).r-0.25)*2.0,0.0,1.0);
    vec3 rock = mix(vec3(0.13,0.14,0.145),vec3(0.25,0.225,0.19),broad);
    rock *= 1.0 + (dot(detail,vec3(0.3333))-0.5)*0.12*nearDetail;
    rock *= 0.97 + 0.03*sin(position.y*0.023+position.x*0.003+position.z*0.002+broad*8.0);
    vec3 grass = mix(vec3(0.04,0.065,0.025),vec3(0.14,0.155,0.075),coverage) * (0.95 + grain*0.1);
    float slope = 1.0 - n.y;
    float cliff = smoothstep(0.08,0.42,slope);
    float beach = 1.0-smoothstep(20.0,35.0,position.y);
    float alpine = smoothstep(1000.0,1650.0,position.y + coverage*130.0);
    vec3 surface = mix(grass,rock,max(max(cliff,beach),alpine));
    float talus = smoothstep(600.0,1200.0,position.y) * smoothstep(0.08,0.22,slope) * (1.0-smoothstep(0.35,0.55,slope));
    vec3 scree = mix(vec3(0.16,0.15,0.13),vec3(0.24,0.23,0.20),coverage) * (0.95+grain*0.1);
    surface = mix(surface,scree,talus*(0.35+coverage*0.45));
    float shade = 1.0-max(0.0,dot(n,normalize(vec3(-0.5,0.7,0.45))));
    float snow = smoothstep(1680.0,2120.0,position.y + coverage*150.0 + shade*230.0) * smoothstep(0.28,0.78,n.y);
    vec3 snowIce = mix(vec3(0.40,0.58,0.65),vec3(0.76,0.81,0.84),smoothstep(0.45,0.9,n.y));
    surface = mix(surface,snowIce,snow);
    float light = 0.32 + 0.9*max(0.0,dot(n,normalize(vec3(-0.5,0.7,0.45))));
    float haze = smoothstep(4000.0,10000.0,distance(cc_cameraPos.xz,position.xz));
    return CCFragOutput(vec4(mix(surface*light,vec3(0.32,0.48,0.57),haze),1.0));
  }
}%
