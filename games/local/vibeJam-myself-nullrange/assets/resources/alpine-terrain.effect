CCEffect %{
  techniques:
  - passes:
    - vert: alpine-vs:vert
      frag: alpine-fs:frag
      properties:
        mainTexture: { value: grey }
        slateTexture: { value: grey }
}%
CCProgram alpine-vs %{
  precision highp float;
  #include <legacy/input>
  #include <builtin/uniforms/cc-global>
  #include <legacy/local-batch>
  out vec3 position;
  out vec3 normal;
  vec4 vert () {
    vec4 p; CCVertInput(p);
    mat4 world; CCGetWorldMatrix(world);
    position = (world * p).xyz;
    normal = normalize((world * vec4(a_normal, 0.0)).xyz);
    return cc_matProj * cc_matView * vec4(position, 1.0);
  }
}%
CCProgram alpine-fs %{
  precision highp float;
  #include <legacy/output-standard>
  #include <builtin/uniforms/cc-global>
  in vec3 position;
  in vec3 normal;
  uniform sampler2D mainTexture;
  uniform sampler2D slateTexture;
  vec4 frag () {
    vec3 n = normalize(normal);
    vec3 weights = pow(abs(n), vec3(4.0)); weights /= weights.x + weights.y + weights.z;
    vec3 rock = SRGBToLinear(texture(slateTexture, position.zy / 46.0).rgb) * weights.x
      + SRGBToLinear(texture(slateTexture, position.xz / 46.0).rgb) * weights.y
      + SRGBToLinear(texture(slateTexture, position.xy / 46.0).rgb) * weights.z;
    float grain = texture(mainTexture,position.xz/38.0).r;
    float broad = texture(mainTexture,position.xz/260.0).r;
    vec3 grass = mix(vec3(0.017,0.043,0.015),vec3(0.09,0.14,0.043),grain) * (0.65 + broad);
    float slope = 1.0 - n.y;
    float cliff = smoothstep(0.14,0.46,slope);
    float beach = 1.0-smoothstep(20.0,35.0,position.y);
    vec3 surface = mix(grass,rock,max(cliff,beach));
    float snow = smoothstep(1200.0,1700.0,position.y + broad*130.0) * smoothstep(0.35,0.9,n.y);
    surface = mix(surface,vec3(0.65,0.73,0.77),snow);
    float light = 0.55 + 0.7*max(0.0,dot(n,normalize(vec3(-0.5,0.7,0.45))));
    float haze = smoothstep(4000.0,10000.0,distance(cc_cameraPos.xz,position.xz));
    return CCFragOutput(vec4(mix(surface*light,vec3(0.32,0.48,0.57),haze),1.0));
  }
}%
