CCEffect %{
  techniques:
  - passes:
    - vert: ridge-vs:vert
      frag: ridge-fs:frag
      properties:
        mainTexture: { value: grey }
}%
CCProgram ridge-vs %{
  precision highp float;
  #include <legacy/input>
  #include <builtin/uniforms/cc-global>
  #include <legacy/local-batch>
  out vec3 position;
  out vec3 normal;
  vec4 vert () {
    vec4 p; CCVertInput(p);
    mat4 world; CCGetWorldMatrix(world);
    position = (world * p).xyz;
    normal = normalize((world * vec4(a_normal, 0.0)).xyz);
    return cc_matProj * cc_matView * vec4(position, 1.0);
  }
}%
CCProgram ridge-fs %{
  precision highp float;
  #include <legacy/output-standard>
  #include <builtin/uniforms/cc-global>
  in vec3 position;
  in vec3 normal;
  uniform sampler2D mainTexture;
  vec4 frag () {
    vec3 n = normalize(normal);
    vec3 weights = pow(abs(n),vec3(4.0)); weights /= weights.x+weights.y+weights.z;
    vec3 rock = SRGBToLinear(texture(mainTexture,position.zy/180.0).rgb)*weights.x
      + SRGBToLinear(texture(mainTexture,position.xz/180.0).rgb)*weights.y
      + SRGBToLinear(texture(mainTexture,position.xy/180.0).rgb)*weights.z;
    float grain = texture(mainTexture,position.xz/350.0).r;
    float snow = smoothstep(580.0,920.0,position.y+grain*180.0)*smoothstep(0.60,0.85,n.y);
    vec3 surface = mix(rock*vec3(0.69,0.79,0.87),vec3(0.72,0.81,0.87),snow);
    float light = 0.4+0.8*max(0.0,dot(n,normalize(vec3(-0.5,0.7,0.45))));
    float haze = min(0.5,1.0-exp(-distance(cc_cameraPos.xyz,position)*0.00010));
    return CCFragOutput(vec4(mix(surface*light,vec3(0.22,0.34,0.42),haze),1.0));
  }
}%
