{
  "name": "@coffeeeeffoc/three-choose-two",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "三块选两块：竖屏积木消除、三选二取舍与三十关空间挑战",
  "exports": {
    "./engine": {
      "types": "./src/engine.d.mts",
      "default": "./src/engine.mjs"
    },
    "./shapes": "./src/shapes.mjs",
    "./levels": "./src/levels.mjs",
    "./progress": "./src/progress.mjs",
    "./canvas": "./native/canvas.mjs"
  },
  "scripts": {
    "dev": "node server.mjs",
    "start": "node server.mjs",
    "build": "node build.mjs",
    "preview": "node server.mjs --dist",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node build.mjs && node tests/browser.mjs",
    "test:online:browser": "node build.mjs && node tests/online.browser.mjs",
    "build:native": "node ../../../apps/shell-minigame/scripts/build.mjs --game three-choose-two",
    "test:native": "node ../../../scripts/native-game-smoke.mjs --standalone --game three-choose-two --platform wechat && node ../../../scripts/native-game-smoke.mjs --standalone --game three-choose-two --platform bilibili"
  },
  "dependencies": {
    "@coffeeeeffoc/game-contract": "workspace:*"
  },
  "coffeeeeffoc": {
    "role": "game"
  }
}
