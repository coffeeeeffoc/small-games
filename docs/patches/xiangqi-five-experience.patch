+.challenge-panel { border:1px solid #b7c3a7; border-radius:5px; padding:10px; background:#eef0e4; margin:4px 0 7px; }
+.challenge-heading { display:flex; flex-wrap:wrap; gap:4px 12px; justify-content:space-between; font-size:14px; }
+.challenge-heading small { font-size:11px; color:#657357; }
+.challenge-panel p { font-size:12px; line-height:1.5; margin:6px 0; }
+.challenge-panel .challenge-hint { padding:6px 8px; background:#fff7df; border-left:2px solid #b29243; }
+.challenge-actions { display:flex; gap:5px; }
+.challenge-actions button { flex:1; min-width:0; min-height:44px; padding:6px 4px; font-size:12px; white-space:nowrap; border:1px solid #b7c3a7; border-radius:4px; background:#fbfaf2; }
+.challenge-panel #challenge-share-message:empty { display:none; }
+.challenge-panel label { font-size:12px; }
+.challenge-panel input { width:100%; min-height:44px; margin-top:5px; padding:8px; border:1px solid var(--line); background:#fffdf6; }
+.challenge-list { display:grid; gap:9px; }
+.challenge-card { display:block; width:100%; min-height:72px; text-align:left; padding:13px; border:1px solid #b7c3a7; border-radius:4px; background:#f8f6ec; }
+.challenge-card strong { display:flex; justify-content:space-between; gap:10px; font-size:14px; }
+.challenge-card strong span { color:#a47b1f; letter-spacing:2px; }
+.challenge-card small { display:block; margin-top:6px; font-size:12px; line-height:1.5; color:#697363; }
+body.challenge-active .action-panel { display:none; }
+body.challenge-active #coach-hint { display:none; }
+.challenge-coordinate { position:absolute; top:1px; left:2px; color:#797b65; font:9px/1 var(--sans); pointer-events:none; }
+body.challenge-active.play-focus .board-scroll { width:min(100%,calc((100dvh - 280px) * var(--board-ratio))); }
+@media (min-width:560px) and (max-height:500px) and (orientation:landscape) {
+  body.challenge-active.play-focus .board-scroll { width:100%; }
