# 仅示例；不填真实密码、client secret，不提交生产 .env。
MANAGEMENT_CAPABILITIES=admin
MANAGEMENT_DATABASE_URL=
ADMIN_ORIGIN=https://admin.nenggongzhiren.cn
ADMIN_ALLOWED_EMAILS=1521152077@qq.com
ADMIN_GITHUB_CLIENT_ID=
ADMIN_GITHUB_CLIENT_SECRET=
# 代理实际 TCP 地址，必须为一个准确私网/回环 IP；不接受 CIDR。
MANAGEMENT_TRUSTED_PROXY_IP=
# 管理跨域白名单与公共比赛白名单独立；CORS 不替代会话/CSRF 鉴权。
ADMIN_CORS_ORIGINS=https://admin.nenggongzhiren.cn
ADMIN_CORS_METHODS=GET,POST,OPTIONS
ADMIN_CORS_HEADERS=content-type,x-csrf-token
ADMIN_CORS_CREDENTIALS=true
ADMIN_CORS_MAX_AGE=600
# 公共接口保留已有 localhost:8080；只有确认真实 Origin 后才追加，拒绝 *。
COMPETITION_ORIGINS=http://localhost:8080
COMPETITION_CORS_METHODS=GET,POST,OPTIONS
COMPETITION_CORS_HEADERS=authorization,content-type
COMPETITION_CORS_CREDENTIALS=false
COMPETITION_CORS_MAX_AGE=600
# 微信实际 Origin：待平台确认，留空，不编造域名。
# 抖音实际 Origin：待平台确认，留空，不编造域名。
# B站实际 Origin：待平台确认，留空，不编造域名。
# TapTap实际 Origin：待平台确认，留空，不编造域名。
# COMPETITION_CORS_ORIGINS如显式设置将优先于旧COMPETITION_ORIGINS；不要留空覆盖既有白名单。
