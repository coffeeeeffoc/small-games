[Unit]
Description=Back up company Caddy certificates and configuration
After=docker.service

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 /usr/local/lib/company-caddy-backup/backup.py
Nice=19
IOSchedulingClass=idle
CPUQuota=10%
MemoryMax=128M
TimeoutStartSec=5min
NoNewPrivileges=true
PrivateTmp=true
PrivateNetwork=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/company-caddy
