# Copy to .env.deployment.local in the repository for bundle selection only.
# On the deployment host copy this template to .env and fill the selected services.
DEPLOY_SERVICES=runtime,kart,tianxia
DEPLOY_FRONTEND=1
DEPLOY_H5_AD_MODE=mock
# DEPLOY_OUTPUT_DIR=.scratch/deployment/my-release
# DEPLOY_RELEASE=my-release

# Gateway binds host loopback 127.0.0.1:8080. Use a TLS reverse proxy for public access.
APP_ORIGIN=http://localhost:8080
# Generate each independently: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
POSTGRES_PASSWORD=
RUNTIME_DB_PASSWORD=
MANAGEMENT_DB_PASSWORD=
COMPETITION_INTERNAL_KEY=
# Server-only JSON: [{"platform":"wechat","appId":"your-app-id","secret":"server-secret"}]
# Empty means only browser guest login; it does not simulate platform authentication.
COMPETITION_PLATFORM_CONFIG=[]

# Required only if management is selected; provision the S3-compatible bucket first.
STUDIO_ORIGIN=http://localhost:5174
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Never put these server values in VITE_ variables, game assets or Pages settings.
