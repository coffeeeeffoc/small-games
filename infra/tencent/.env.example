# Copy to .env.tencent.local at the repository root. Existing environment variables take priority.
# Linux server with Docker CE + Compose v2; SSH user must be able to run docker without sudo.
ECS_HOST=
ECS_USER=
ECS_SSH_PORT=22
# Optional absolute local private-key path; otherwise use your SSH agent/default keys.
ECS_SSH_KEY=
ECS_DEPLOY_DIR=/opt/small-games
# Existing server directory containing fullchain.pem and privkey.pem for GAME_DOMAIN.
ECS_TLS_DIR=/opt/small-games/certs
GAME_DOMAIN=

# Existing bucket: name-APPID, e.g. arcade-1250000000; region e.g. ap-shanghai.
# Only the static COS_PREFIX/releases/ prefix must allow anonymous GetObject. Never public write.
COS_BUCKET=
COS_REGION=
COS_PREFIX=small-games
COS_SECRET_ID=
COS_SECRET_KEY=
COS_SESSION_TOKEN=
# Local Python with cos-python-sdk-v5 installed; an absolute executable path also works.
COS_PYTHON=python

# Generate EACH value separately: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Keep database passwords stable after first deployment; changing env does not rotate existing DB roles.
POSTGRES_PASSWORD=
RUNTIME_DB_PASSWORD=
COMPETITION_INTERNAL_KEY=
