# Extra virtual hosts are preserved between game releases (e.g. the future company website).
include /etc/nginx/extra/*.conf;
map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}
upstream game_cos {
    zone game_cos 64k;
    resolver 127.0.0.11 valid=30s ipv6=off;
    server ${COS_HOST}:443 resolve;
}
server {
    listen 8080;
    location = /health { return 200 'ok'; }
}
server {
    listen 80 default_server;
    server_name _;
    return 444;
}
server {
    listen 80;
    server_name ${GAME_DOMAIN};
    return 308 https://${GAME_DOMAIN}$request_uri;
}
server {
    listen 443 ssl;
    server_name ${GAME_DOMAIN};
    ssl_certificate /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    client_max_body_size 1m;
    resolver 127.0.0.11 valid=30s ipv6=off;
    add_header X-Content-Type-Options nosniff always;
    add_header Permissions-Policy 'fullscreen=(self)' always;

    location = / {
        add_header Cache-Control no-store;
        return 302 /releases/${RELEASE_ID}/$is_args$args;
    }
    # Internal settlement/auth routes must never be exposed to public clients.
    location = /api/competition/v1/internal { return 404; }
    location ^~ /api/competition/v1/internal/ { return 404; }
    location /api/competition/v1/ {
        set $runtime runtime:43002;
        proxy_pass http://$runtime;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Competition-Internal-Key '';
        proxy_read_timeout 15s;
    }
    location = /health {
        set $runtime runtime:43002;
        proxy_pass http://$runtime/health;
    }
    location = /health/kart {
        set $kart runtime:43003;
        proxy_pass http://$kart/health;
    }
    location = /kart {
        set $kart runtime:43003;
        proxy_pass http://$kart;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 75s;
        proxy_buffering off;
    }
    # Hash routes need no SPA fallback. Missing JS/JSON must remain a real 404.
    location ^~ /releases/ {
        limit_except GET { deny all; }
        rewrite ^/releases/(.*)/$ /${COS_PREFIX}/releases/$1/index.html break;
        rewrite ^/releases/(.*)$ /${COS_PREFIX}/releases/$1 break;
        proxy_pass https://game_cos;
        proxy_set_header Host ${COS_HOST};
        proxy_set_header Authorization '';
        proxy_set_header Cookie '';
        proxy_set_header X-Competition-Internal-Key '';
        proxy_ssl_server_name on;
        proxy_ssl_name ${COS_HOST};
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
        # COS default domains may send attachments; the site serves these as inline resources.
        proxy_hide_header Content-Disposition;
    }
    location / { return 404; }
}
