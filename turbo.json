{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "dist-iframe/**"],
      "env": [
        "BILIBILI_AD_UNIT_ID",
        "VITE_SHELL_ORIGIN",
        "VITE_CULTIVATION_ARTIFACT_URL",
        "VITE_CULTIVATION_ARTIFACT_VERSION",
        "VITE_CULTIVATION_ARTIFACT_INTEGRITY"
      ]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:contract": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "smoke": {
      "dependsOn": ["build"],
      "outputs": []
    }
  }
}
