{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "assets/**",
    "games/local/carding-car/scripts/toolchain.mjs",
    "games/local/carding-car/scripts/native-targets.mjs",
    "games/local/carding-car/scripts/clear-output.mjs",
    "platforms/**",
    "scripts/**",
    "services/runtime-api/rules/**"
  ],
  "globalPassThroughEnv": ["COCOS_CREATOR", "KART_PREBUILT_DIR", "NIGHT_OVERWATCH_PREBUILT_DIR"],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        "dist/**",
        "dist-pages/**",
        "dist-iframe/**",
        "dist-content/**",
        "public/vendor/**"
      ],
      "env": [
        "BILIBILI_AD_UNIT_ID",
        "VITE_SHELL_ORIGIN",
        "VITE_CULTIVATION_ARTIFACT_URL",
        "VITE_CULTIVATION_ARTIFACT_VERSION",
        "VITE_CULTIVATION_ARTIFACT_INTEGRITY"
      ]
    },
    "@coffeeeeffoc/shell-web#build": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": ["dist/**"]
    },
    "@coffeeeeffoc/shell-web#build:pages": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@coffeeeeffoc/game-building-power#test": {
      "dependsOn": ["^build"],
      "outputs": ["$TURBO_ROOT$/test-results/building-power/shift-witness.json"]
    },
    "test:contract": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "env": ["KART_PREBUILT_DIR"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "smoke": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "@coffeeeeffoc/shell-minigame#smoke": {
      "dependsOn": ["build", "@coffeeeeffoc/game-building-power#test"],
      "outputs": [],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/scripts/native-game-smoke.mjs"]
    },
    "@coffeeeeffoc/shell-bilibili#smoke": {
      "dependsOn": ["build"],
      "outputs": [],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/scripts/native-game-smoke.mjs"]
    },
    "@coffeeeeffoc/game-building-power#smoke": {
      "dependsOn": ["build", "test"],
      "outputs": []
    },
    "@coffeeeeffoc/travel-bund#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/assets/bund/runtime/**"],
      "outputs": ["dist/**"]
    },
    "@coffeeeeffoc/carding-car#build": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": ["dist/**"],
      "env": ["COCOS_CREATOR", "KART_PREBUILT_DIR"]
    },
    "@coffeeeeffoc/night-overwatch#build": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": ["dist/**"],
      "env": ["COCOS_CREATOR", "NIGHT_OVERWATCH_PREBUILT_DIR"]
    }
  }
}
