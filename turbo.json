{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        "dist/**",
        "dist-pages/**",
        "dist-iframe/**",
        "dist-content/**",
        "public/vendor/**"
      ],
      "env": [
        "BILIBILI_AD_UNIT_ID",
        "VITE_SHELL_ORIGIN",
        "VITE_CULTIVATION_ARTIFACT_URL",
        "VITE_CULTIVATION_ARTIFACT_VERSION",
        "VITE_CULTIVATION_ARTIFACT_INTEGRITY"
      ]
    },
    "@coffeeeeffoc/shell-web#build:pages": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:contract": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "env": ["KART_PREBUILT_DIR"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "smoke": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "@coffeeeeffoc/shell-minigame#smoke": {
      "dependsOn": ["build"],
      "outputs": [],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/scripts/native-game-smoke.mjs"]
    },
    "@coffeeeeffoc/shell-bilibili#smoke": {
      "dependsOn": ["build"],
      "outputs": [],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/scripts/native-game-smoke.mjs"]
    },
    "@coffeeeeffoc/travel-bund#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/assets/bund/runtime/**"],
      "outputs": ["dist/**"]
    },
    "@coffeeeeffoc/carding-car#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "env": ["COCOS_CREATOR", "KART_PREBUILT_DIR"]
    }
  }
}
