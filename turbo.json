{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "package.json",
    "pnpm-lock.yaml",
    "scripts/validation-plan.mjs",
    "scripts/validate-tree.mjs",
    "scripts/validate-push.mjs",
    "assets/**",
    "platforms/h5/**",
    "games/local/carding-car/scripts/**",
    "scripts/cocos-validation.mjs",
    "scripts/workspace-bootstrap.mjs",
    "scripts/rule-tasks.mjs",
    "scripts/competition-service-config.mjs",
    "scripts/competition-h5-service.mjs",
    "scripts/h5-ad-config.mjs",
    "platforms/competition/service-config.js"
  ],
  "globalPassThroughEnv": [
    "COCOS_CREATOR",
    "KART_PREBUILT_DIR",
    "NIGHT_OVERWATCH_PREBUILT_DIR",
    "ORBIT_ATELIER_PREBUILT_DIR",
    "TIANXIA_PREBUILT_DIR"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "env": [
        "COMPETITION_SERVICE_ENABLED",
        "COMPETITION_PUBLIC_API_URL",
        "H5_ADS_ENABLED",
        "TAPTAP_COPS_ROBBERS_AD_UNIT_ID",
        "TAPTAP_COPS_ROBBERS_REALTIME_AD_UNIT_ID",
        "TAPTAP_XIANGQI_FIVE_AD_UNIT_ID"
      ],
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        "dist/**",
        "dist-pages/**",
        "dist-iframe/**",
        "dist-content/**",
        "public/vendor/**"
      ],
      "env": [
        "COMPETITION_SERVICE_ENABLED",
        "COMPETITION_PUBLIC_API_URL",
        "H5_ADS_ENABLED",
        "TAPTAP_COPS_ROBBERS_AD_UNIT_ID",
        "TAPTAP_COPS_ROBBERS_REALTIME_AD_UNIT_ID",
        "TAPTAP_XIANGQI_FIVE_AD_UNIT_ID",
        "BILIBILI_AD_UNIT_ID",
        "VITE_SHELL_ORIGIN"
      ]
    },
    "@coffeeeeffoc/admin-web#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/admin-csp.mjs",
        "$TURBO_ROOT$/scripts/admin-csp.d.mts"
      ],
      "outputs": ["dist/**"]
    },
    "@coffeeeeffoc/shell-web#build": {
      "dependsOn": ["^build"],
      "cache": false,
      "env": [
        "COMPETITION_SERVICE_ENABLED",
        "COMPETITION_PUBLIC_API_URL",
        "H5_ADS_ENABLED",
        "TAPTAP_COPS_ROBBERS_AD_UNIT_ID",
        "TAPTAP_COPS_ROBBERS_REALTIME_AD_UNIT_ID",
        "TAPTAP_XIANGQI_FIVE_AD_UNIT_ID"
      ],
      "outputs": ["dist/**"]
    },
    "@coffeeeeffoc/shell-web#build:pages": {
      "dependsOn": ["^build"],
      "cache": false,
      "env": [
        "COMPETITION_SERVICE_ENABLED",
        "COMPETITION_PUBLIC_API_URL",
        "H5_ADS_ENABLED",
        "TAPTAP_COPS_ROBBERS_AD_UNIT_ID",
        "TAPTAP_COPS_ROBBERS_REALTIME_AD_UNIT_ID",
        "TAPTAP_XIANGQI_FIVE_AD_UNIT_ID"
      ],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:contract": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "env": ["KART_PREBUILT_DIR"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "smoke": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "@coffeeeeffoc/shell-minigame#smoke": {
      "dependsOn": ["build"],
      "outputs": [],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/scripts/native-game-smoke.mjs"]
    },
    "@coffeeeeffoc/travel-bund#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/assets/bund/runtime/**"],
      "outputs": ["dist/**"]
    },
    "@coffeeeeffoc/carding-car#build": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": ["dist/**"],
      "env": ["COCOS_CREATOR", "KART_PREBUILT_DIR"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/games/local/carding-car/.prebuilt/**",
        "$TURBO_ROOT$/platforms/kart-sharing.js"
      ]
    },
    "@coffeeeeffoc/night-overwatch#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "env": ["COCOS_CREATOR", "NIGHT_OVERWATCH_PREBUILT_DIR"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/games/local/night-overwatch/.prebuilt/**"]
    },
    "test:rules": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@coffeeeeffoc/orbit-atelier#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "env": ["COCOS_CREATOR", "ORBIT_ATELIER_PREBUILT_DIR"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/games/local/orbit-atelier/.prebuilt/**"]
    },
    "@coffeeeeffoc/tianxia-chalu#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "env": ["COCOS_CREATOR", "TIANXIA_PREBUILT_DIR"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/games/local/tianxia-chalu/.prebuilt/**"]
    }
  }
}
